@page "/products"
@using TP4___TRANI.Models
@using TP4___TRANI.Services
@inject ProductService ProductService
@inject NavigationManager Navigation

<h3>Productos</h3>

@if (products == null)
{
    <p>Cargando productos...</p>
}
else
{
    <button @onclick="NuevoProducto" style="margin-bottom:10px;">
        + Nuevo Producto
    </button>

    <table border="1" cellpadding="5" cellspacing="0" width="100%">
        <thead>
            <tr>
                <th>ID</th>
                <th>Título</th>
                <th>Precio</th>
                <th>Categoría</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in products)
            {
                <tr>
                    <td>@product.Id</td>
                    <td>@product.Title</td>
                    <td>$@product.Price</td>
                    <td>@product.Category</td>
                    <td>
                        <button @onclick="() => Editar(product.Id)">Editar</button>
                        <button @onclick="() => Eliminar(product.Id)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Product>? products;

    protected override async Task OnInitializedAsync()
    {
        products = await ProductService.GetProductsAsync();
    }

    private void NuevoProducto()
    {
        Navigation.NavigateTo("/createproduct");
    }

    private void Editar(int id)
    {
        Navigation.NavigateTo($"/editproduct/{id}");
    }

    private void Eliminar(int id)
    {
        Navigation.NavigateTo($"/deleteproduct/{id}");
    }
}