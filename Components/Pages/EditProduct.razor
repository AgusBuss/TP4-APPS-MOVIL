@page "/editproduct/{Id:int}"
@using TP4___TRANI.Models
@using TP4___TRANI.Services
@using System.Net
@inject ProductService ProductService
@inject NavigationManager Navigation

<h3>Editar Producto</h3>

@if (product == null)
{
    <p>Cargando producto...</p>
}
else
{
    <p style="color:green; font-weight:bold;">Respuesta de la API: @codigoRespuesta</p>

    <div>
        <label>Título</label><br />
        <input @bind="product.Title" style="width:300px;" /><br /><br />

        <label>Precio</label><br />
        <input @bind="product.Price" type="number" style="width:300px;" /><br /><br />

        <label>Descripción</label><br />
        <textarea @bind="product.Description" style="width:300px; height:80px;"></textarea><br /><br />

        <label>Categoría</label><br />
        <input @bind="product.Category" style="width:300px;" /><br /><br />

        <label>URL Imagen</label><br />
        <input @bind="product.Image" style="width:300px;" /><br /><br />

        <button @onclick="Actualizar">Guardar cambios</button>
        <button @onclick="Volver" style="margin-left:10px;">Cancelar</button>

        @if (codigoActualizacion != null)
        {
            <p style="color:green; font-weight:bold;">Respuesta actualización: @codigoActualizacion</p>
        }
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Product? product;
    private string codigoRespuesta = "";
    private string? codigoActualizacion;

    protected override async Task OnInitializedAsync()
    {
        var (producto, codigo) = await ProductService.GetProductByIdAsync(Id);
        product = producto;
        codigoRespuesta = $"{(int)codigo} {codigo}";
    }

    private async Task Actualizar()
    {
        if (product != null)
        {
            var (resultado, codigo) = await ProductService.UpdateProductAsync(Id, product);
            codigoActualizacion = $"{(int)codigo} {codigo}";
            await Task.Delay(2000);
            Navigation.NavigateTo("/products");
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo("/products");
    }
}