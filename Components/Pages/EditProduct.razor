@page "/editproduct/{Id:int}"
@using TP4___TRANI.Models
@using TP4___TRANI.Services
@inject ProductService ProductService
@inject NavigationManager Navigation

<h3>Editar Producto</h3>

@if (product == null)
{
    <p>Cargando producto...</p>
}
else
{
    <div>
        <label>Título</label><br />
        <input @bind="product.Title" style="width:300px;" /><br /><br />

        <label>Precio</label><br />
        <input @bind="product.Price" type="number" style="width:300px;" /><br /><br />

        <label>Descripción</label><br />
        <textarea @bind="product.Description" style="width:300px; height:80px;"></textarea><br /><br />

        <label>Categoría</label><br />
        <input @bind="product.Category" style="width:300px;" /><br /><br />

        <label>URL Imagen</label><br />
        <input @bind="product.Image" style="width:300px;" /><br /><br />

        <button @onclick="Actualizar">Guardar cambios</button>
        <button @onclick="Volver" style="margin-left:10px;">Cancelar</button>

        @if (mensaje != null)
        {
            <p style="color:green;">@mensaje</p>
        }
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Product? product;
    private string? mensaje;

    protected override async Task OnInitializedAsync()
    {
        product = await ProductService.GetProductByIdAsync(Id);
    }

    private async Task Actualizar()
    {
        if (product != null)
        {
            var resultado = await ProductService.UpdateProductAsync(Id, product);
            if (resultado != null)
            {
                mensaje = "Producto actualizado correctamente";
                await Task.Delay(1500);
                Navigation.NavigateTo("/products");
            }
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo("/products");
    }
}