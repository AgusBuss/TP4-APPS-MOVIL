@page "/deleteproduct/{Id:int}"
@using TP4___TRANI.Models
@using TP4___TRANI.Services
@inject ProductService ProductService
@inject NavigationManager Navigation

<h3>Eliminar Producto</h3>

@if (product == null)
{
    <p>Cargando producto...</p>
}
else
{
    <div>
        <p>¿Estás seguro que querés eliminar este producto?</p>

        <table border="1" cellpadding="5" cellspacing="0">
            <tr><th>ID</th><td>@product.Id</td></tr>
            <tr><th>Título</th><td>@product.Title</td></tr>
            <tr><th>Precio</th><td>$@product.Price</td></tr>
            <tr><th>Categoría</th><td>@product.Category</td></tr>
            <tr><th>Descripción</th><td>@product.Description</td></tr>
        </table>

        <br />
        <button @onclick="Eliminar" style="background:red; color:white;">
            Confirmar Eliminación
        </button>
        <button @onclick="Volver" style="margin-left:10px;">
            Cancelar
        </button>

        @if (mensaje != null)
        {
            <p style="color:green;">@mensaje</p>
        }
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Product? product;
    private string? mensaje;

    protected override async Task OnInitializedAsync()
    {
        product = await ProductService.GetProductByIdAsync(Id);
    }

    private async Task Eliminar()
    {
        var resultado = await ProductService.DeleteProductAsync(Id);
        if (resultado)
        {
            mensaje = "Producto eliminado correctamente";
            await Task.Delay(1500);
            Navigation.NavigateTo("/products");
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo("/products");
    }
}